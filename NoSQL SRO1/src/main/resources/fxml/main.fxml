<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1150.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="kz.kotov.sms.controller.MainController">
   <top>
      <VBox BorderPane.alignment="CENTER">
         <children>
            <MenuBar>
               <menus>
                  <Menu mnemonicParsing="false" text="Файл">
                     <items>
                        <MenuItem fx:id="menuAdd" mnemonicParsing="false" onAction="#onAdd" text="Новый студент">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="N" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                           </accelerator>
                        </MenuItem>
                        <MenuItem mnemonicParsing="false" onAction="#onSave" text="Сохранить">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                           </accelerator>
                        </MenuItem>
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#onImport" text="Импорт из CSV…" />
                        <MenuItem mnemonicParsing="false" onAction="#onExport" text="Экспорт в CSV…" />
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#onExit" text="Выход">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="Q" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                           </accelerator>
                        </MenuItem>
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Правка">
                     <items>
                        <MenuItem fx:id="menuEdit" mnemonicParsing="false" onAction="#onEdit" text="Изменить">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="E" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                           </accelerator>
                        </MenuItem>
                        <MenuItem fx:id="menuDelete" mnemonicParsing="false" onAction="#onDelete" text="Удалить">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="D" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                           </accelerator>
                        </MenuItem>
                        <SeparatorMenuItem mnemonicParsing="false" />
                        <MenuItem mnemonicParsing="false" onAction="#onFocusSearch" text="Найти">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="F" control="UP" meta="UP" shift="UP" shortcut="DOWN" />
                           </accelerator>
                        </MenuItem>
                        <MenuItem mnemonicParsing="false" onAction="#onResetFilters" text="Сбросить фильтры" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Сервис">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#onStatistics" text="Статистика" />
                     </items>
                  </Menu>
                  <Menu mnemonicParsing="false" text="Справка">
                     <items>
                        <MenuItem mnemonicParsing="false" onAction="#onAbout" text="О программе">
                           <accelerator>
                              <KeyCodeCombination alt="UP" code="F1" control="UP" meta="UP" shift="UP" shortcut="UP" />
                           </accelerator>
                        </MenuItem>
                     </items>
                  </Menu>
               </menus>
            </MenuBar>
            <ToolBar>
               <items>
                  <Button mnemonicParsing="false" onAction="#onAdd" text="➕ Добавить">
                     <tooltip><Tooltip text="Добавить студента (Ctrl+N)" /></tooltip>
                  </Button>
                  <Button fx:id="btnEdit" mnemonicParsing="false" onAction="#onEdit" text="✏ Изменить">
                     <tooltip><Tooltip text="Изменить выбранного (Ctrl+E)" /></tooltip>
                  </Button>
                  <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDelete" text="🗑 Удалить">
                     <tooltip><Tooltip text="Удалить выбранного (Ctrl+D / Delete)" /></tooltip>
                  </Button>
                  <Separator orientation="VERTICAL" />
                  <Button mnemonicParsing="false" onAction="#onSave" text="💾 Сохранить">
                     <tooltip><Tooltip text="Сохранить данные (Ctrl+S)" /></tooltip>
                  </Button>
                  <Button mnemonicParsing="false" onAction="#onStatistics" text="📊 Статистика" />
               </items>
            </ToolBar>
         </children>
      </VBox>
   </top>
   <center>
      <VBox spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="filter-bar">
               <children>
                  <Label text="Поиск:" />
                  <TextField fx:id="searchField" promptText="ФИО или e-mail" HBox.hgrow="ALWAYS" />
                  <Label text="Группа:" />
                  <ComboBox fx:id="groupFilter" prefWidth="140.0" />
                  <Label text="Курс:" />
                  <ComboBox fx:id="courseFilter" prefWidth="120.0" />
                  <Button mnemonicParsing="false" onAction="#onResetFilters" text="Сбросить" />
               </children>
            </HBox>
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colId" maxWidth="60.0" minWidth="45.0" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colName" prefWidth="260.0" text="ФИО" />
                  <TableColumn fx:id="colGroup" prefWidth="90.0" text="Группа" />
                  <TableColumn fx:id="colCourse" maxWidth="80.0" minWidth="55.0" prefWidth="65.0" text="Курс" />
                  <TableColumn fx:id="colEmail" prefWidth="230.0" text="E-mail" />
                  <TableColumn fx:id="colGpa" maxWidth="80.0" minWidth="55.0" prefWidth="65.0" text="GPA" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
               <placeholder>
                  <Label text="Нет студентов, удовлетворяющих условиям поиска" />
               </placeholder>
            </TableView>
         </children>
         <padding>
            <Insets bottom="10.0" left="12.0" right="6.0" top="12.0" />
         </padding>
      </VBox>
   </center>
   <right>
      <VBox prefWidth="280.0" spacing="10.0" styleClass="card" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="card-title" text="Карточка студента" />
            <Label fx:id="cardName" styleClass="card-name" text="Студент не выбран" wrapText="true" />
            <GridPane hgap="10.0" vgap="8.0">
               <columnConstraints>
                  <ColumnConstraints minWidth="80.0" prefWidth="90.0" />
                  <ColumnConstraints hgrow="ALWAYS" minWidth="100.0" prefWidth="150.0" />
               </columnConstraints>
               <children>
                  <Label styleClass="card-key" text="Группа:" />
                  <Label fx:id="cardGroup" text="—" GridPane.columnIndex="1" />
                  <Label styleClass="card-key" text="Курс:" GridPane.rowIndex="1" />
                  <Label fx:id="cardCourse" text="—" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label styleClass="card-key" text="Дата рожд.:" GridPane.rowIndex="2" />
                  <Label fx:id="cardBirth" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label styleClass="card-key" text="E-mail:" GridPane.rowIndex="3" />
                  <Label fx:id="cardEmail" text="—" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label styleClass="card-key" text="Телефон:" GridPane.rowIndex="4" />
                  <Label fx:id="cardPhone" text="—" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label styleClass="card-key" text="GPA:" GridPane.rowIndex="5" />
                  <Label fx:id="cardGpa" styleClass="card-gpa" text="—" GridPane.columnIndex="1" GridPane.rowIndex="5" />
               </children>
            </GridPane>
         </children>
         <BorderPane.margin>
            <Insets bottom="10.0" left="6.0" right="12.0" top="12.0" />
         </BorderPane.margin>
         <padding>
            <Insets bottom="14.0" left="14.0" right="14.0" top="14.0" />
         </padding>
      </VBox>
   </right>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="status-bar" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="statusLabel" text="Готово" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="countLabel" text="Показано: 0 из 0" />
         </children>
         <padding>
            <Insets bottom="5.0" left="12.0" right="12.0" top="5.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
